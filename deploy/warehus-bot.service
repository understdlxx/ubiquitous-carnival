# WAREHUS BOT — systemd service (premium / VPS hosting)
#
# 1) Upload the bot folder to your server, e.g. /opt/warehus-bot
# 2) Put your token in /opt/warehus-bot/.env :
#       DISCORD_TOKEN=your_token_here
#    (or paste it straight into the Environment= line below)
# 3) Install & start:
#       sudo cp warehus-bot.service /etc/systemd/system/
#       sudo systemctl daemon-reload
#       sudo systemctl enable --now warehus-bot
# 4) Check logs:
#       journalctl -u warehus-bot -f

[Unit]
Description=WAREHUS Discord Bot (old school chill, new school security)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/warehus-bot
ExecStart=/usr/bin/python3 /opt/warehus-bot/main.py
EnvironmentFile=/opt/warehus-bot/.env
Restart=always
RestartSec=5
# crash-proofing
MemoryMax=512M

[Install]
WantedBy=multi-user.target
